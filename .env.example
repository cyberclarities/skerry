# Skerry environment template.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so keep
# real values out of it.
#
#     cp .env.example .env
#
# docker-compose passes the whole .env through to the web service
# (env_file: .env). Restart the stack after any change here.

# --- Core -----------------------------------------------------------------
SERVER_NAME=skerry.example.com
BASE_URL=https://skerry.example.com
PORT=5000

# openssl rand -hex 32
SECRET_KEY=

# Bootstrap admin. Used once, on first start, to create the account.
# Changing these later has no effect — manage the account in the UI.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/risk_register.db

# Set before first run. Changing it later does not renumber existing records.
RISK_ID_PREFIX=SKR

# --- Scoring thresholds ---------------------------------------------------
RAG_RED_THRESHOLD=15
RAG_AMBER_THRESHOLD=9
RISK_APPETITE_THRESHOLD=8

# --- SMTP — leave blank to disable email notification ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=skerry@example.com
SMTP_USE_TLS=true

# --- Azure AD SSO — leave blank to disable --------------------------------
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_ADMIN_GROUP=
OIDC_OPERATOR_GROUP=
OIDC_VIEWER_GROUP=

# --- CrowdStrike Falcon Spotlight ingest ----------------------------------
# Falcon console: Support and resources -> API clients and keys -> Create API
# client. Grant one scope: Spotlight vulnerabilities = Read. Nothing here
# writes back to CrowdStrike, so read on one service is all the key needs.
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# us-1 | us-2 | eu-1 | us-gov-1 | us-gov-2
# The wrong region returns 401 with a perfectly valid key.
FALCON_CLOUD_REGION=us-1

# Or set the base URL directly and the region is ignored:
# FALCON_BASE_URL=https://api.us-2.crowdstrike.com

# The Spotlight API requires an FQL filter — there is no "everything" query.
# Narrow this until the New queue is a number a person can actually work.
# Start narrow for the first real sync, e.g.:
#   status:'open'+cve.is_cisa_kev:true
# For a large tenant, limit by severity until the sync runs as a background job:
#   status:['open','reopen']+cve.severity:['CRITICAL','HIGH']
SPOTLIGHT_FQL_FILTER=status:'open',status:'reopen'

SPOTLIGHT_PAGE_SIZE=400
SPOTLIGHT_SYNC_ENABLED=false
SPOTLIGHT_SYNC_HOUR=5
SPOTLIGHT_SYNC_MINUTE=30
FALCON_HTTP_TIMEOUT=60

# Seconds gunicorn lets one request run before killing the worker. A manual
# Spotlight sync runs inside the request, so this must outlast the largest
# sync. Default 1800 (30 minutes). Requires a rebuild to take effect.
GUNICORN_TIMEOUT=1800
